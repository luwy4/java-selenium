<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Calculator Master Suite"
       parallel="tests"
       thread-count="2">

    <!-- SUITE 1: BASIC TESTS -->
    <test name="Basic Math Tests">

        <!-- Parameter passing -->
        <parameter name="env" value="local"/>
        <parameter name="tester" value="Vy"/>

        <groups>
            <run>
                <include name="math_basic"/>
            </run>
        </groups>

        <classes>
            <class name="session1.exercise2_1.tests.CalculatorTest">
                <methods>
                    <include name="testAdd"/>
                    <include name="testSubtract"/>
                    <include name="testMultiply"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- SUITE 2: EDGE CASES -->
    <test name="Edge Case &amp; Advanced Tests">

        <parameter name="env" value="staging"/>
        <parameter name="tester" value="Vy"/>

        <groups>
            <run>
                <include name="edge_case"/>
                <include name="advanced"/>
            </run>
        </groups>

        <classes>
            <class name="session1.exercise2_1.tests.CalculatorTest">
                <methods>
                    <include name="testDivide"/>
                    <include name="testDivideByZero"/>
                    <include name="testWithSoftAssert"/>
                </methods>
            </class>
        </classes>

    </test>
</suite>